	author = {Julier, S.J. and Uhlmann, J.K.},
	month = jun,
	year = {1997},
	keywords = {Covariance matrix, Information filtering, Information filters, Predictive models, Random variables, Sensor fusion, Sensor systems, State estimation, Vehicles, Yield estimation},
	pages = {2369--2373}
}


